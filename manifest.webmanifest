{
  "name": "Gestão de Atividades Pessoal",
  "short_name": "Atividades",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14213d",
  "theme_color": "#14213d",
  "lang": "pt-BR",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {"name": "arquivos", "accept": ["text/plain", ".txt", "application/zip", "application/x-zip-compressed", ".zip"]}
      ]
    }
  }
}
